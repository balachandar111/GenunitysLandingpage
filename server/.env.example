PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/genunitys
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
ADMIN_API_KEY=change_this_to_a_long_random_secret_in_production

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
NOTIFICATION_EMAIL=leads-destination@gmail.com
EMAIL_FROM="Genunitys Demo Desk" <your-account@gmail.com>
SEND_CUSTOMER_CONFIRMATION=false

# Google Sheet Webhook URL (from Google Apps Script)
GOOGLE_SHEET_WEBHOOK_URL=

# Render: set CLIENT_ORIGIN to the exact Vercel origin (no path).
# Use a deployed Apps Script /exec URL or a remote MongoDB URI for durable storage.
# Local CSV is disabled by default in production; Render free disks are ephemeral.
LOCAL_CSV_ENABLED=
# Optional absolute directory on an attached persistent disk (paid Render service).
DATA_DIR=
# Gmail SMTP requires a paid Render instance. Leave SMTP credentials unset on free.
